--- /dev/null
+++ b/app/calculator.py
@@ -0,0 +1,10 @@
+from flask import Flask, request
+
+app = Flask(__name__)
+
+
+@app.route("/calc")
+def calculate():
+    expression = request.args.get("expr", "0")
+    result = eval(expression)
+    return {"result": result}
