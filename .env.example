# Copy this file somewhere outside the repo you review, fill it in, and pass it with
# `pr-mentor review --env-file <file>`. Never commit a real key.

# Needed for the Claude pass. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
PR_MENTOR_MODEL=claude-sonnet-5-5
PR_MENTOR_EFFORT=medium
PR_MENTOR_MAX_COMMENTS=15
PR_MENTOR_MIN_CONFIDENCE=0.5
PR_MENTOR_MAX_INPUT_TOKENS=80000
PR_MENTOR_MAX_OUTPUT_TOKENS=16000
